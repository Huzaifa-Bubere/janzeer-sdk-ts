{
  "name": "@janzeer/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for the Janzeer blockchain: wallet keys and signing, transaction builders, typed REST client, JSON-RPC over HTTP and WebSocket subscriptions.",
  "license": "Apache-2.0",
  "homepage": "https://janzeer.org",
  "repository": { "type": "git", "url": "https://github.com/janzeer/janzeer-sdk-ts.git" },
  "keywords": ["janzeer", "blockchain", "sdk", "wallet", "secp256k1", "json-rpc"],
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=18" },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }, "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" } },
    "./crypto": { "import": { "types": "./dist/crypto.d.ts", "default": "./dist/crypto.js" }, "require": { "types": "./dist/crypto.d.cts", "default": "./dist/crypto.cjs" } },
    "./rest": { "import": { "types": "./dist/rest.d.ts", "default": "./dist/rest.js" }, "require": { "types": "./dist/rest.d.cts", "default": "./dist/rest.cjs" } },
    "./rpc": { "import": { "types": "./dist/rpc.d.ts", "default": "./dist/rpc.js" }, "require": { "types": "./dist/rpc.d.cts", "default": "./dist/rpc.cjs" } },
    "./vault": { "import": { "types": "./dist/vault.d.ts", "default": "./dist/vault.js" }, "require": { "types": "./dist/vault.d.cts", "default": "./dist/vault.cjs" } }
  },
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test examples",
    "test": "vitest run --exclude test/e2e/**",
    "test:watch": "vitest",
    "e2e": "vitest run test/e2e",
    "check:vectors": "node scripts/check-vectors.mjs",
    "docs": "typedoc",
    "examples": "node scripts/run-examples.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@scure/bip39": "^2.2.0"
  },
  "peerDependencies": { "ws": ">=8" },
  "peerDependenciesMeta": { "ws": { "optional": true } },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "eslint": "^9.30.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typedoc": "^0.28.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.0",
    "ws": "^8.18.0"
  }
}
